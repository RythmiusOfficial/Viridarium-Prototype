/*
	w = 0-14, h = 0-14
	0 = empty, 1 = wall
	
	0 = 000001111111111
	1 = 000001000000001
	2 = 111111011110001
	3 = 100000000010001
	4 = 101111111011111
	5 = 101001100010000
	6 = 101001101110000
	7 = 101101101110000
	8 = 100000000010000
	9 = 111111111010000
   10 = 000000111010000
   11 = 000000100010000
   12 = 000000101110000
   13 = 000000101000000 
   14 = 000000111000000
*/

function scr_build_map() {
	var g = ds_grid_create(global.wwidth, global.wheight);
	ds_grid_set_region(g, 0, 0, (global.wwidth - 1), (global.wheight - 1), 0);
	
	// BUILD WALLS
	#region r0
	g[# 5, 0] = 1;
	g[# 6, 0] = 1;
	g[# 7, 0] = 1;
	g[# 8, 0] = 1;
	g[# 9, 0] = 1;
	g[# 10, 0] = 1;
	g[# 11, 0] = 1;
	g[# 12, 0] = 1;
	g[# 13, 0] = 1;
	g[# 14, 0] = 1;
	#endregion
	#region r1
	g[# 5, 1] = 1;
	g[# 14, 1] = 1;
	#endregion
	#region r2
	g[# 0, 2] = 1;
	g[# 1, 2] = 1;
	g[# 2, 2] = 1;
	g[# 3, 2] = 1;
	g[# 4, 2] = 1;
	g[# 5, 2] = 1;
	g[# 7, 2] = 1;
	g[# 8, 2] = 1;
	g[# 9, 2] = 1;
	g[# 10, 2] = 1;
	g[# 14, 2] = 1;
	#endregion
	#region r3
	g[# 0, 3] = 1;
	g[# 10, 3] = 1;
	g[# 14, 3] = 1;
	#endregion
	#region r4
	g[# 0, 4] = 1;
	g[# 2, 4] = 1;
	g[# 3, 4] = 1;
	g[# 4, 4] = 1;
	g[# 5, 4] = 1;
	g[# 6, 4] = 1;
	g[# 7, 4] = 1;
	g[# 8, 4] = 1;
	g[# 10, 4] = 1;
	g[# 11, 4] = 1;
	g[# 12, 4] = 1;
	g[# 13, 4] = 1;
	g[# 14, 4] = 1;
	#endregion
	#region r5
	g[# 0, 5] = 1;
	g[# 2, 5] = 1;
	g[# 5, 5] = 1;
	g[# 6, 5] = 1;
	g[# 10, 5] = 1;
	#endregion
	#region r6
	g[# 0, 6] = 1;
	g[# 2, 6] = 1;
	g[# 5, 6] = 1;
	g[# 6, 6] = 1;
	g[# 8, 6] = 1;
	g[# 9, 6] = 1;
	g[# 10, 6] = 1;
	#endregion
	#region r7
	g[# 0, 7] = 1;
	g[# 2, 7] = 1;
	g[# 3, 7] = 1;
	g[# 5, 7] = 1;
	g[# 6, 7] = 1;
	g[# 8, 7] = 1;
	g[# 9, 7] = 1;
	g[# 10, 7] = 1;
	#endregion
	#region r8
	g[# 0, 8] = 1;
	g[# 10, 8] = 1;
	#endregion
	#region r9
	g[# 0, 9] = 1;
	g[# 1, 9] = 1;
	g[# 2, 9] = 1;
	g[# 3, 9] = 1;
	g[# 4, 9] = 1;
	g[# 5, 9] = 1;
	g[# 6, 9] = 1;
	g[# 7, 9] = 1;
	g[# 8, 9] = 1;
	g[# 10, 9] = 1;
	#endregion
	#region r10
	g[# 6, 10] = 1;
	g[# 7, 10] = 1;
	g[# 8, 10] = 1;
	g[# 10, 10] = 1;
	#endregion
	#region r11
	g[# 6, 11] = 1;
	g[# 10, 11] = 1;
	#endregion
	#region r12
	g[# 6, 12] = 1;
	g[# 8, 12] = 1;
	g[# 9, 12] = 1;
	g[# 10, 12] = 1;
	#endregion
	#region r13
	g[# 6, 13] = 1;
	g[# 8, 13] = 1;
	#endregion
	#region r14
	g[# 6, 14] = 1;
	g[# 7, 14] = 1;
	g[# 8, 14] = 1;
	#endregion
	
	// RETURN
	return g;
}
